{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Development;Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_DEFAULT_BUILD_TYPE": "Development"
      }
    },
    {
      "name": "host-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "host-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "host-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64 (Ninja)",
      "inherits": [
        "ninja",
        "host-macos"
      ]
    },
    {
      "name": "macos-arm64-xcode",
      "displayName": "macOS ARM64 (Xcode project)",
      "inherits": [
        "base",
        "host-macos"
      ],
      "generator": "Xcode"
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja + clang-cl)",
      "inherits": [
        "ninja",
        "host-windows"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "windows-x64-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022 + ClangCL)",
      "inherits": [
        "base",
        "host-windows"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "ClangCL"
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (Ninja + Clang)",
      "inherits": [
        "ninja",
        "host-linux"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-x64-server",
      "displayName": "Linux x64 headless server",
      "inherits": "linux-x64",
      "cacheVariables": {
        "DG_HEADLESS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android ARM64 (NDK, needs ANDROID_NDK_HOME)",
      "inherits": "ninja",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "DG_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-dev",
      "configurePreset": "macos-arm64",
      "configuration": "Development"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-xcode-debug",
      "configurePreset": "macos-arm64-xcode",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-xcode-dev",
      "configurePreset": "macos-arm64-xcode",
      "configuration": "Development"
    },
    {
      "name": "macos-arm64-xcode-release",
      "configurePreset": "macos-arm64-xcode",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-dev",
      "configurePreset": "windows-x64",
      "configuration": "Development"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-vs2022-debug",
      "configurePreset": "windows-x64-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-vs2022-dev",
      "configurePreset": "windows-x64-vs2022",
      "configuration": "Development"
    },
    {
      "name": "windows-x64-vs2022-release",
      "configurePreset": "windows-x64-vs2022",
      "configuration": "Release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-dev",
      "configurePreset": "linux-x64",
      "configuration": "Development"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64-server-debug",
      "configurePreset": "linux-x64-server",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-server-dev",
      "configurePreset": "linux-x64-server",
      "configuration": "Development"
    },
    {
      "name": "linux-x64-server-release",
      "configurePreset": "linux-x64-server",
      "configuration": "Release"
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64",
      "configuration": "Debug"
    },
    {
      "name": "android-arm64-dev",
      "configurePreset": "android-arm64",
      "configuration": "Development"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
